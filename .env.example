# Optional server-only market-data access. Demo works without credentials.
# Use the least-privilege credentials supported by Architect. No order endpoints exist here.
ARCHITECT_API_KEY=
ARCHITECT_API_SECRET=
ARCHITECT_ENV=sandbox
# Optional gating for authenticated market data on a public deployment.
# If keys are set, DATA_ACCESS_TOKEN is required. Send via Authorization: Bearer <token>.
DATA_ACCESS_TOKEN=
